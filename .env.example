# Copy this file to .env (backend) and/or .env.local (frontend) and fill in real values.
# Never commit a file containing real secrets.

# ---- Database (PostgreSQL) ----
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/josh_jewellery
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change_me

# ---- JWT ----
# Generate your own 256-bit base64 secret, e.g.: openssl rand -base64 32
JWT_SECRET=change_me_base64_secret
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ---- Seed Admin Account (created automatically on first backend startup) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me
ADMIN_NAME=Store Admin

# ---- Razorpay Payments ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Outgoing Mail (order confirmations etc.) ----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ---- Frontend ----
# Base URL the React app uses to reach the backend API. Safe to expose publicly (not a secret).
VITE_API_BASE_URL=http://localhost:8080/api
